{
	"name": "@just-func/play-react",
	"version": "0.2.20",
	"private": true,
	"scripts": {
		"build": "vite build",
		"build:storybook": "storybook build",
		"build:watch": "echo no build:watch",
		"clean": "rimraf coverage dist lib --glob \"*.tsbuildinfo\"",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"dev": "vite",
		"lint": "biome check .",
		"nuke": "run-s clean nuke:local",
		"nuke:local": "rimraf node_modules || true",
		"preview": "vite preview",
		"sb": "storybook dev -p 6006",
		"start": "vite",
		"storybook": "storybook dev -p 6006",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify": "run-p build typecheck lint coverage depcheck",
		"verify:build": "run-s clean build typecheck depcheck"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
