{
  "extends": "@just-web/repo-scripts/config/tsconfig.jsx.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "outDir": "lib",
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "rootDir": "ts",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": [
    "ts"
  ]
}
