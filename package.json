{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"format": "biome check --write .",
		"lint": "turbo run lint",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"postpack": "pinst --enable",
		"prepack": "pinst --disable",
		"prepare": "husky install",
		"react": "pnpm --filter=@just-func/play-react",
		"size": "turbo run size",
		"solid": "pnpm --filter=@just-func/play-solid",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "turbo run build typecheck lint coverage depcheck size",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^2.25.0",
		"@commitlint/cli": "^17.0.2",
		"@commitlint/config-conventional": "^17.0.2",
		"@just-web/repo-scripts": "^0.3.1",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^8.0.1",
		"pinst": "^3.0.0",
		"plop": "^3.1.1",
		"turbo": "^1.6.3",
		"typescript": "^4.8.4"
	},
	"packageManager": "pnpm@11.1.3"
}
