{
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"format": "biome check --write .",
		"lint": "turbo run lint",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"postpack": "pinst --enable",
		"prepack": "pinst --disable",
		"prepare": "husky",
		"react": "pnpm --filter=@just-func/play-react",
		"solid": "pnpm --filter=@just-func/play-solid",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"verify": "turbo run build typecheck lint coverage depcheck",
		"version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^2.29.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@just-web/repo-scripts": "^0.3.1",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"pinst": "^3.0.0",
		"plop": "^3.1.1",
		"turbo": "^2.10.12",
		"typescript": "~5.9.3"
	},
	"packageManager": "pnpm@11.1.3"
}
